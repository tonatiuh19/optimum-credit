# ─────────────────────────────────────────────────────────────────────────────
# Optimum Credit — Environment Variables Reference
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Full public URL of the app (no trailing slash). Used in email + invite links + CORS.
# Local:  http://localhost:8080
# Prod:   https://www.ofgllc.com   (prefer custom domain — not *.vercel.app)
PUBLIC_APP_URL=https://www.ofgllc.com
# Public API origin for Twilio MMS mediaUrl + status callbacks, and MCP admin-ask.
# Prefer the production host when developing locally — Twilio cannot fetch localhost.
# OPTIMUM_API_BASE_URL=https://www.ofgllc.com
# Optional comma-separated extra browser origins allowed for API CORS
# (in addition to PUBLIC_APP_URL, Vercel URL, localhost, and ofgllc.com).
# CORS_ALLOWED_ORIGINS=https://www.ofgllc.com,https://ofgllc.com

# ── JWT ──────────────────────────────────────────────────────────────────────
# Long random string used to sign auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_random_64_chars

# ── Database (TiDB Cloud Serverless / MySQL 8.0) ─────────────────────────────
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=optimum_credit
DB_SSL=true

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Optimum Credit <no-reply@yourdomain.com>

# ── Payments — Authorize.net ─────────────────────────────────────────────────
AUTHORIZENET_API_LOGIN_ID=your_login_id
AUTHORIZENET_TRANSACTION_KEY=your_transaction_key
# Set to "true" for sandbox, "false" for production
AUTHORIZENET_SANDBOX=true
# Webhook signature key from Authorize.net → Account → Webhooks (production)
ANET_WEBHOOK_SIGNATURE_KEY=

# ── Authorize.net (Vite client-side — safe to expose) ────────────────────────
VITE_AUTHORIZENET_API_LOGIN_ID=your_login_id
VITE_AUTHORIZENET_CLIENT_KEY=your_client_key
VITE_AUTHORIZENET_SANDBOX=true

# ── Twilio (SMS/MMS — optional) ───────────────────────────────────────────────
# Account credentials only. Outbound From numbers come from admin_phone_numbers
# (assigned in People). Staff without an assigned OFG number cannot send/receive
# SMS (Conversations, staff notify SMS, SMS OTP, or client SMS from their actions).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# REQUIRED for browser softphone (Voice SDK). Without these, Device register fails
# with AccessTokenInvalid (20101) / JWT is invalid (31204). SMS still works with
# ACCOUNT_SID + AUTH_TOKEN alone.
# Create at Twilio Console → Account → API keys & tokens (Standard key).
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret
# Optional: pin an existing TwiML App SID. If unset, API creates/finds
# "Optimum Credit Voice App" with voiceUrl → {PUBLIC}/api/voice/twiml
# TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED on Vercel production. Without TWILIO_AUTH_TOKEN, POST /api/webhooks/twilio/sms
# returns 503 and Twilio records error 11200 (inbound SMS never reaches Conversations).
# Optional DisruptingLabs MMS endpoint (archival). Twilio uses our public
# /api/conversations/media/public/:id URL (base from OPTIMUM_API_BASE_URL /
# PUBLIC_APP_URL, skipping localhost) — CDN dirs often return HTML.
# Media retained 365 days; cron process-queue deletes expired rows.
# Max upload 4MB (under Vercel serverless body limit).
# MMS_UPLOAD_ENDPOINT=https://disruptinglabs.com/data/api/uploadMMS.php
# MMS_UPLOAD_SECRET=

# ── Ably (Conversations realtime — optional) ──────────────────────────────────
# Root API key from Ably app → API Keys (format: appId.keyName:keySecret).
# When unset or invalid, Conversations still works with light inbox polling (30s).
# Copy the **Root** key from Ably → your app → API Keys. Format: appId.keyName:secret
# No quotes. Invalid keys log once then soft-fail (503 ably_not_configured).
# ABLY_API_KEY=xxxxxx.yyyyyy:zzzzzzzz

# ── Document Encryption ───────────────────────────────────────────────────────
# 32-byte hex key for AES-256 document encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOC_ENCRYPTION_KEY=change_me_64_hex_chars

# ── Cron Job (notification queue processor) ───────────────────────────────────
# Secret for /api/cron/process-queue. Vercel Cron (vercel.json, every 5 min)
# calls GET with Authorization: Bearer <CRON_SECRET>. cPanel curl can POST with
# x-cron-secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Endpoint: GET|POST /api/cron/process-queue
CRON_SECRET=change_me_random_64_hex_chars
# Credit report reads: large reports are split into page ranges read in parallel (verified against
# the report's own totals). "off" disables splitting; it also pauses itself when 40%+ of recent
# split reads had to be re-read in one pass. CRON_SECRET is also used to start each read in its
# own invocation (/api/internal/credit-file-read).
CREDIT_FILE_SPLIT_READS=on

# ── Bulk CSV import (admin Clients) ───────────────────────────────────────────
# Off when BULK_CSV_IMPORT_ENABLED=0
# In production: require BULK_CSV_IMPORT_ENABLED=1 or BULK_CSV_IMPORT_ALLOW_PRODUCTION=1
# In non-production: enabled by default when unset
# BULK_CSV_IMPORT_ENABLED=1
# BULK_CSV_IMPORT_ALLOW_PRODUCTION=0

# ── Credit Repair Cloud ───────────────────────────────────────────────────────
# "false" = wizard owns pipeline stages; CRC inbound webhooks ignored (client create sync still runs)
CRC_SYNC_STAGES=false

# ── CDN (optional) ───────────────────────────────────────────────────────────
# DisruptingLabs / HostGator shared hosting (documents + optional MMS archival).
# External dependency: TLS/AutoSSL on disruptinglabs.com has broken before → Node
# "fetch failed". Upload helper uses timeout + retries; Vitest stubs (no live calls).
# Allowed remote types: JPG/PNG/GIF/WEBP/PDF/ENC (app encrypts docs as .enc).
# CDN_UPLOAD_URL=https://disruptinglabs.com/data/api/uploadFiles.php
# CDN_UPLOAD_SECRET=
# CDN_MAIN_FOLDER=optimum-credit
# CDN_UPLOAD_TIMEOUT_MS=15000
# CDN_UPLOAD_MAX_ATTEMPTS=3
# Best-effort delete when a DB transaction fails after upload (same host as upload API)
# CDN_DELETE_URL=https://disruptinglabs.com/data/api/deleteFiles.php

# ── Vite / Builder (optional) ─────────────────────────────────────────────────
VITE_PUBLIC_BUILDER_KEY=

# ── Affiliates feature flag ───────────────────────────────────────────────────
# Set to 0|false to lock Affiliates / My Affiliate in the admin nav (same lock
# icon as Conversations), block those routes + APIs, and disable /r/:slug.
# Set to 1|true (or omit) when subscription pricing is ready to ship.
# Single source of truth — server applies it to section_locks for the UI.
AFFILIATES_ENABLED=0

# ── Business Funding (Settings UI) ────────────────────────────────────────────
# Outbound SMS for client funding confirmations uses system_settings key
# `funding_sms_from_phone_number_id` (admin_phone_numbers.id). Configure in
# Admin → Settings → Business Funding (defaults to Cesar OFG line when seeded).
# Staff funding alerts: funding_doc_upload (doc uploads), funding_application_created (manual intake).
#
# Signup / activation SMS (convert + first payment) uses
# `signup_notify_sms_from_phone_number_id` — Admin → Settings → Signup SMS
# (seeds Lecca (949) 736-5644 when that number is in admin_phone_numbers).

# ── Credit Repair Cloud / Connect Cloud (deferred P2) ─────────────────────────
# Platform Updates PDF: kill CRC stage sync when wizard owns pipeline (already
# CRC_SYNC_STAGES=false). Full Connect Cloud OAuth + social DM inbox (FB/IG)
# is deferred until vendor credentials + product scope are confirmed.
# CONNECT_CLOUD_ENABLED=0
# CONNECT_CLOUD_CLIENT_ID=
# CONNECT_CLOUD_CLIENT_SECRET=
# SOCIAL_DM_INBOX_ENABLED=0
# META_WEBHOOK_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_APP_SECRET=
# ── Admin AI Ask (single feature flag) ────────────────────────────────────────
# Off by default. Set to 1|true to enable in-app Ask for super_admin + admin.
# Requires ANTHROPIC_API_KEY (billed on your Anthropic account, not clients).
# Also used to enhance pre-sale credit-analysis narratives (Round 1–4 copy)
# when set — scores/accounts stay rules-engine only; fails open if unset.
# ADMIN_AI_ENABLED=0
# ANTHROPIC_API_KEY=
# Optional model override (Messages API). Default: claude-sonnet-4-6
# (claude-sonnet-4-20250514 retired 2026-06-15 — do not use.)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Inbound AI agent (SMS + voice) — OFF by default (no behavior change) ──────
# Independent of ADMIN_AI_ENABLED. Requires ANTHROPIC_API_KEY for FAQ auto-replies.
# Safety: AI only answers info / round status / report links (code-level reply
# guard blocks other links, unverified $/scores/dates and deletion promises).
# Optional: separate Anthropic key (billing/rate limits) for SMS triage only.
# Unset = SMS uses ANTHROPIC_API_KEY. Voice always uses ANTHROPIC_API_KEY.
# On 401/invalid key SMS escalates to staff (no fallback to the shared key).
# ANTHROPIC_SMS_API_KEY=
# Required only when ANTHROPIC_SMS_API_KEY is a user-level "all workspaces" key
# (sk-ant-usr-…): the workspace to bill (Console → Settings → Workspaces, wrkspc_…).
# ANTHROPIC_SMS_WORKSPACE_ID=
# STOP/HELP/START + hard escalate work with the SMS flag alone (no Claude needed).
# Only runs on OFG numbers that have an assigned admin.
# Optional allowlist for phased rollout (unset = all assigned lines; does NOT change
# Twilio SMS/voice routing — only whether the AI agent answers):
#   INBOUND_AI_ADMIN_IDS=90001          # César only
#   INBOUND_AI_ADMIN_IDS=90001,150002   # César + Lecca later
# SMS: ack Twilio immediately; Claude/send/notify continue via waitUntil (@vercel/functions).
# Voice: AI-first Gather on /api/voice/incoming → /api/voice/ai-turn (press 0 = human)
# Ops: enable Twilio Messaging Service **Advanced Opt-Out** on OFG numbers so carrier
# STOP is enforced even if app logic misses a keyword variant.
# INBOUND_AI_SMS_ENABLED=0
# INBOUND_AI_VOICE_ENABLED=0
# INBOUND_AI_ADMIN_IDS=90001
# Minutes after a staff text during which the SMS AI stays silent (0 = off; default 120)
# INBOUND_AI_STAFF_ACTIVE_MINUTES=120

# ── WhatsApp (360dialog) — OFF by default (no behavior change) ────────────────
# César's WA Business (profile phone (951) 378-3429). Conversations channel=whatsapp
# for the assigned admin only. Inbound webhook + outbound text (session window).
# WHATSAPP_360DIALOG_ENABLED=0
# D360_API_KEY=
# Optional override if profile phone lookup should not be used:
# WHATSAPP_ASSIGNED_ADMIN_ID=
# Webhook verify (GET hub.challenge) — set same token in 360dialog / Meta:
# WHATSAPP_360DIALOG_VERIFY_TOKEN=
# Webhook URL: {PUBLIC_APP_URL}/api/webhooks/360dialog/whatsapp

# MCP (Claude Connectors / Cursor) — preferred: remote OAuth at /api/mcp
# Each admin Connects in Claude → consents in-app → revokes in My profile.
# Optional break-glass master token (ops only; prefer per-admin OAuth):
# ADMIN_AI_MCP_TOKEN=
# ADMIN_AI_MCP_ADMIN_ID=

# ── Call transcripts (Conversations) ──────────────────────────────────────────
# Always ON. Recording webhook enqueues + processes immediately; cron is backup.
# Twilio Batch Transcription (Deepgram, EN/ES) writes the transcript.
# Accept the AI/ML addendum: Voice → Settings → Privacy & Security.
# Ops kill-switch only: CALL_INSIGHTS_ENABLED=0
# CALL_INSIGHTS_ENABLED=0

# ── MyFreeScoreNow affiliate API (gated OFF) ──────────────────────────────────
# Omit or MFSN_ENABLED=0 — no outbound MFSN calls, QR/analysis/wizard unchanged.
# Local UAT probe only: set MFSN_ENABLED=1 plus affiliate API user/password from
# MFSN API Access Setup (Sandbox). Quote values that contain #.
# Do not store consumer member passwords. Do not set these on Vercel prod until
# Legal UX PDF is approved and IP whitelist allows Vercel egress.
# MFSN_ENABLED=0
# MFSN_API_BASE_URL=https://uat-api.myfreescorenow.com
# MFSN_API_EMAIL="API#UserTest_29544"
# MFSN_API_PASSWORD=
# MFSN_CLIENT_TOKEN=
# Optional override for /get-credit-report SMS From (default César OFG +19496740714)
# GET_CREDIT_REPORT_SMS_FROM_E164=+19496740714

# ── HubSpot (My Tasks Work Hub) ───────────────────────────────────────────────
# 2026.03 Tasks API uses contacts scopes (NOT crm.objects.tasks.*).
# Preferred: Service Key with crm.objects.contacts.read + crm.objects.contacts.write
#   Development → Keys → Service keys → Create → add CRM contacts read/write
HUBSPOT_SERVICE_KEY=
# Optional Projects OAuth (same contacts scopes on the app):
# Redirect URI: {PUBLIC_APP_URL}/api/admin/hubspot/oauth/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Docs review task ──────────────────────────────────────────────────────────
# When a new client completes every required onboarding task, a "Review & approve
# documents" work task is created (one per case, auto-closed when all approved).
# Assignee admin id; unset = Lecca (150002).
# DOCS_REVIEW_ASSIGNEE_ADMIN_ID=150002

# ── Round 6+ audit alert ──────────────────────────────────────────────────────
# Publishing a progress report for round >= ROUND_AUDIT_MIN_ROUND (default 6)
# sends an SMS + in-app alert (no email) to these admins so the dispute team
# audits extended-round files. One alert per case + round. Default: Lecca.
# ROUND_AUDIT_ALERT_ADMIN_IDS=150002
# ROUND_AUDIT_MIN_ROUND=6
# Two sent rounds in a row with no items removed and no score gain: SMS + in-app (default Lecca, Cesar).
# ROUND_NO_CHANGE_ALERT_ADMIN_IDS=150002,90001

# ── Three-way calls ("Add caller" in the softphone) ───────────────────────────
# Quick-dial buttons (US numbers). Any US number can also be typed.
# VOICE_THREE_WAY_PRESETS=[{"label":"SmartCredit","number":"+1XXXXXXXXXX"},{"label":"MyFreeScoreNow","number":"+1XXXXXXXXXX"}]

# ── Prospect traffic light (semáforo) ─────────────────────────────────────────
# Hot prospect with no movement for 3 days → alert these admins (default Cesar).
# LEAD_HOT_STALE_ALERT_ADMIN_IDS=90001

# Slack — "what's new" release notes after deploy (scripts/deploy-prod.ts, local .env)
SLACK_BOT_TOKEN=
# GF-8 scorecard: marketing channel name (default ofg-marketing); optional 4 PM report channel (id or name) when not a group DM
PRODUCTIVITY_SLACK_MARKETING_CHANNEL=
PRODUCTIVITY_SLACK_REPORT_CHANNEL=
SLACK_RELEASES_CHANNEL_ID=
# Slack List "Bug or Feature Request" — rows with Status=Done are announced once (bot needs lists:read)
SLACK_REQUESTS_LIST_ID=

# Platform billing (OFG invoice). Stripe account that bills OFG; webhook → /api/webhooks/stripe
STRIPE_SECRET_KEY=
# Served to the Billing page Payment Element by the API (no VITE_ copy needed); must match the secret key mode
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Admin ids allowed to open Billing (default Alex 30001, Cesar 90001)
BILLING_ADMIN_IDS=30001,90001
# Progress reports (Spec v1.1 P0-1): who may release reports + override a failed self-check (besides the EN/ES language owners)
REPORT_RELEASE_MANAGER_IDS=30001,90001
# Daily SMS + email while no card is saved for platform billing (default Cesar)
BILLING_PM_ALERT_ADMIN_IDS=90001
# Platform owner: edits prices + sees provider (Claude) cost (default Alex 30001)
BILLING_OWNER_IDS=30001

# Local server: real email / SMS / WhatsApp are OFF by default (they print "[email:local-dry-run]").
# A local server uses the production database and builds http://localhost links, so only turn this on
# on purpose. Outgoing localhost links are rewritten to https://www.ofgllc.com when it is on.
# LOCAL_SEND_REAL_MESSAGES=1
